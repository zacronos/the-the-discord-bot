{
  "name": "the-the-discord-bot",
  "version": "0.1.0",
  "description": "Discord bot for anonymous community polls: invite votes and channel-permanence votes with per-server configurable counting rules.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test",
    "register-commands": "node --env-file-if-exists=.env scripts/register-commands.mjs",
    "invite-url": "node --env-file-if-exists=.env scripts/invite-url.mjs",
    "health-check": "node --env-file-if-exists=.env scripts/health-check.mjs"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  }
}
